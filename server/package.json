{
  "name": "@live-mindmap/server",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "live-mindmap": "./src/cli.ts"
  },
  "scripts": {
    "dev": "node src/server.ts",
    "cli": "node src/cli.ts",
    "test": "vitest run --project unit",
    "test:it": "vitest run --project it",
    "test:it:heavy": "vitest run --project heavy",
    "test:it:all": "vitest run --project it --project heavy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json && effect-tsgo diagnostics --project tsconfig.json && node scripts/check-entrypoints.ts && node scripts/check-test-layers.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.288",
    "@effect/platform-node": "4.0.1",
    "effect": "4.0.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.48.1",
    "@effect/vitest": "4.0.1",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
