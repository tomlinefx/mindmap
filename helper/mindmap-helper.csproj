<Project Sdk="Microsoft.NET.Sdk">

  <!-- 会議アプリの音とマイクを取り、文字にして server へ流すヘルパー（ADR 0001）。Windows 専用 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>mindmap-helper</AssemblyName>
    <!-- 配布物（GitHub Releases の zip。scripts/win-release-helper.cmd）の版。helper の振る舞いが変わったら上げる -->
    <Version>0.1.0</Version>
    <RootNamespace>Mindmap.Helper</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- WebRTC AEC3 のシム（scripts/win-webrtc-apm.cmd が作る）。あれば実行ファイルの隣に写す。無くてもビルドは通り、run はエコーキャンセル無しで動く -->
    <None Include=".deps/webrtc-apm/lib/webrtc-apm.dll" Link="webrtc-apm.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('.deps/webrtc-apm/lib/webrtc-apm.dll')" />
    <!-- 実行ファイルを配るときに一緒に配る表示（ADR 0005）: 自分の LICENSE、第三者の一覧、dll に静的リンクした各ライセンスの全文 -->
    <None Include="../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include=".deps/webrtc-apm/lib/LICENSES/*" Link="LICENSES/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
  </ItemGroup>

</Project>
